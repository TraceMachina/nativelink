// The older service config shape: each service is a map keyed by instance
// name, and bytestream lists its stores under `cas_stores`. NativeLink still
// reads this shape and logs the current equivalent at startup. Use it to
// check a migration; new configs should use the list form in basic_cas.json5.
{
  stores: [
    {
      name: "CAS_MAIN_STORE",
      memory: {
        eviction_policy: {
          // 1gb.
          max_bytes: 1000000000,
        },
      },
    },
    {
      name: "AC_MAIN_STORE",
      memory: {
        eviction_policy: {
          // 100mb.
          max_bytes: 100000000,
        },
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        fast: {
          ref_store: {
            name: "CAS_MAIN_STORE",
          },
        },
        slow: {
          noop: {},
        },
      },
    },
  ],
  schedulers: [
    {
      name: "MAIN_SCHEDULER",
      simple: {
        supported_platform_properties: {
          cpu_count: "minimum",
        },
      },
    },
  ],
  servers: [
    {
      listener: {
        http: {
          socket_address: "0.0.0.0:50051",
        },
      },
      services: {
        cas: {
          "": {
            cas_store: "CAS_MAIN_STORE",
          },
        },
        ac: {
          "": {
            ac_store: "AC_MAIN_STORE",
          },
        },
        execution: {
          "": {
            cas_store: "WORKER_FAST_SLOW_STORE",
            scheduler: "MAIN_SCHEDULER",
          },
        },
        capabilities: {
          "": {
            remote_execution: {
              scheduler: "MAIN_SCHEDULER",
            },
          },
        },
        bytestream: {
          cas_stores: {
            main: "WORKER_FAST_SLOW_STORE",
          },
        },
      },
    },
  ],
}
