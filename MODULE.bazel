        "2026-03-24/clippy-nightly-x86_64-unknown-linux-musl.tar.xz": "53be2469c18a0ad6df68cc9a7f0cde801e3e295090034ed702be3c5e0f73c817",
        "2026-03-24/llvm-tools-nightly-x86_64-unknown-linux-musl.tar.xz": "baf11bf996d6d696fad9fbb4b434ae2d9bf354c7709938ecbc3a40ff5dd1880c",
