{
  "name": "nativelink-web",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "katex": "^0.18.2",
    "next": "~16.4.1",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "ts-jest": "^29.4.15",
    "turbo": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@nativelink/docs",
    "dev:web": "turbo run dev --filter=@nativelink/web",
    "format": "biome format --write .",
    "lint": "turbo run lint",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "turbo run typecheck"
  }
}
