load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
)

rust_library(
    name = "nativelink-nix",
    srcs = [
        "src/lib.rs",
        "src/nar_url.rs",
        "src/narinfo.rs",
        "src/nixbase32.rs",
        "src/path_info.rs",
        "src/signing.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nativelink-error",
        "//nativelink-proto",
        "@crates//:base64",
        "@crates//:ed25519-dalek",
        "@crates//:hex",
        "@crates//:prost",
        "@crates//:prost-types",
    ],
)

rust_test(
    name = "unit_test",
    # The proptest suites run thousands of ed25519 and parser cases; the
    # unoptimized test binary needs more than the 60s "short" budget on a
    # remote-execution worker.
    timeout = "moderate",
    crate = ":nativelink-nix",
    deps = [
        "//nativelink-error",
        "//nativelink-proto",
        "@crates//:base64",
        "@crates//:ed25519-dalek",
        "@crates//:hex",
        "@crates//:proptest",
        "@crates//:prost",
        "@crates//:prost-types",
    ],
)

rust_doc(
    name = "docs",
    crate = ":nativelink-nix",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":nativelink-nix",
)
