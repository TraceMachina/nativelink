load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
    "rust_test_suite",
)

rust_library(
    name = "nativelink-sim",
    srcs = [
        "src/actions.rs",
        "src/cas_load.rs",
        "src/checker.rs",
        "src/clock.rs",
        "src/fleet.rs",
        "src/lib.rs",
        "src/net.rs",
        "src/property.rs",
        "src/scenario.rs",
        "src/trace.rs",
        "src/world.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nativelink-config",
        "//nativelink-error",
        "//nativelink-proto",
        "//nativelink-redis-tester",
        "//nativelink-scheduler",
        "//nativelink-service",
        "//nativelink-store",
        "//nativelink-util",
        "//nativelink-worker",
        "@crates//:bytes",
        "@crates//:futures",
        "@crates//:hyper",
        "@crates//:parking_lot",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tonic-prost",
    ],
)

rust_binary(
    name = "fleet-sim",
    srcs = ["src/bin/fleet_sim.rs"],
    deps = [
        ":nativelink-sim",
        "//nativelink-error",
        "//nativelink-proto",
        "//nativelink-util",
        "@crates//:bytes",
        "@crates//:clap",
        "@crates//:futures",
        "@crates//:prost",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_test_suite(
    name = "integration",
    timeout = "long",
    srcs = [
        "tests/fault_policy_test.rs",
        "tests/fleet_test.rs",
        "tests/sim_catalogue_test.rs",
        "tests/sim_harness_test.rs",
        "tests/sim_property_test.rs",
        "tests/sim_scale_test.rs",
        "tests/sim_smoke_test.rs",
        "tests/subscriber_cancel_test.rs",
    ],
    proc_macro_deps = [
        "//nativelink-macro",
    ],
    deps = [
        ":nativelink-sim",
        "//nativelink-config",
        "//nativelink-error",
        "//nativelink-redis-tester",
        "//nativelink-scheduler",
        "//nativelink-store",
        "//nativelink-util",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-test",
    ],
)

rust_test(
    name = "unit_test",
    timeout = "short",
    crate = ":nativelink-sim",
)

rust_doc(
    name = "docs",
    crate = ":nativelink-sim",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":nativelink-sim",
)
